# Cross-compile the native WebRTC dependencies for the PS4 x86_64 Orbis ABI.
if(NOT DEFINED ENV{OO_PS4_TOOLCHAIN})
    message(FATAL_ERROR "Source scripts/ps4-env.ps1 before configuring the Orbis toolchain")
endif()

file(TO_CMAKE_PATH "$ENV{OO_PS4_TOOLCHAIN}" ORBIS_ROOT)
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 12)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(CMAKE_C_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_AR llvm-ar CACHE FILEPATH "Orbis-compatible archive tool")
set(CMAKE_RANLIB llvm-ranlib CACHE FILEPATH "Orbis-compatible archive indexer")
set(CMAKE_MAKE_PROGRAM make CACHE FILEPATH "Project-local GNU Make")
set(CMAKE_SYSROOT "${ORBIS_ROOT}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(DEFINED ENV{GFN_PS4_HOST_PYTHON})
    set(Python3_EXECUTABLE "$ENV{GFN_PS4_HOST_PYTHON}" CACHE FILEPATH "Host Python for Mbed TLS code generation")
endif()

set(CMAKE_C_FLAGS_INIT "-D__ORBIS__ -D_GNU_SOURCE -D_POSIX_C_SOURCE=200809L -fPIC -funwind-tables -isystem \"${ORBIS_ROOT}/include\"")
set(CMAKE_CXX_FLAGS_INIT "-D__ORBIS__ -D_GNU_SOURCE -D_POSIX_C_SOURCE=200809L -fPIC -funwind-tables -isystem \"${ORBIS_ROOT}/include\" -isystem \"${ORBIS_ROOT}/include/c++/v1\"")
set(CMAKE_FIND_ROOT_PATH "${ORBIS_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
